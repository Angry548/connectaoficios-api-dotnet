# Copiar a .env. Sustituir ambos marcadores antes de iniciar.
# SQL: al menos 8 caracteres, mayusculas, minusculas, numeros y simbolos.
# Para esta cadena de conexion, no usar comillas dobles en la password.
# Las comillas simples de dotenv preservan los signos $ literalmente.
MSSQL_SA_PASSWORD='CAMBIAR_PASSWORD_SQL_LOCAL'
# Clave JWT exclusivamente local: al menos 32 bytes aleatorios.
Jwt__Key='CAMBIAR_POR_CLAVE_ALEATORIA_LOCAL_DE_AL_MENOS_32_BYTES'
Jwt__Issuer=ConnectaOficios.Api
Jwt__Audience=ConnectaOficios.Clients
Jwt__ExpirationMinutes=120

# Puerto SQL en Windows; cambiar a 14330 si 1433 esta ocupado.
SQLSERVER_PORT=1433

# Resend solo si se deshabilita el buzon local; testing no requiere credenciales externas.
Resend__ApiKey=
Resend__FromEmail=onboarding@resend.dev
Resend__FromName=ConnectaOficios

# Opcional: completar las tres claves para crear un administrador local.
BootstrapAdmin__Nombre=
BootstrapAdmin__Correo=
BootstrapAdmin__Password=

# SOLO ENTORNO LOCAL; no reutilizar en produccion.
LocalTesting__SeedEnabled=true
LocalTesting__EmailEnabled=true
LocalTesting__Password='LocalOnly-Connecta-2026!'
