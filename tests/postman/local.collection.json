{
  "info": {
    "name": "ConnectaOficios .NET local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "invalidToken",
      "value": "invalid.token.signature"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!new RegExp('^http://(localhost|127[.]0[.]0[.]1|connectaoficios-api)(:[0-9]+)?$').test(pm.environment.get('baseUrl'))) { pm.execution.skipRequest(); throw new Error('Solo API local'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login Cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/login",
        "body": {
          "mode": "raw",
          "raw": "{\"correo\":\"cliente.test@connectaoficios.local\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login Cliente\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const j = pm.response.json(); pm.collectionVariables.set('clienteToken', j.token); pm.collectionVariables.set('clienteId', j.usuario.id); pm.test('Rol exacto', () => pm.expect(j.usuario.rol).eq('Cliente')); }"
            ]
          }
        }
      ]
    },
